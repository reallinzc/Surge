# NAME: AppleIntelligence
# MAINTAINER: reallinzc
# REVIEWED: 2026-11-10
# SOURCE: https://support.apple.com/101555
# Siri, Private Cloud Compute, plus Apple Intelligence region checks.
# Asset/update downloads (mesu, xp, smp-device-content, itunes) and general
# iCloud (gateway, setup, icloud-content) are left to the client's Apple rules.
# gspe1-ssl.ls.apple.com is shared with Maps location; DOMAIN-KEYWORD,siri
# matches any host containing "siri". Both are included on purpose.

# Siri
DOMAIN,guzzoni.apple.com
DOMAIN-SUFFIX,smoot.apple.com
DOMAIN-KEYWORD,siri

# Private Cloud Compute relays
DOMAIN,apple-relay.cloudflare.com
DOMAIN,apple-relay.fastly-edge.com
DOMAIN,cp4.cloudflare.com
DOMAIN,apple-relay.apple.com

# Region / eligibility
DOMAIN,gs-loc-cn.apple.com
DOMAIN,gspe1-ssl.ls.apple.com

# iCloud account services
DOMAIN,p150-acsegateway.icloud.com
